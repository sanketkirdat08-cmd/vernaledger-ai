{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__path__=/api"
    },
    {
      "source": "/receipts/(.*)",
      "destination": "/api/index.py?__path__=/api/receipts/$1"
    },
    {
      "source": "/receipts",
      "destination": "/api/index.py?__path__=/api/receipts"
    },
    {
      "source": "/khata/(.*)",
      "destination": "/api/index.py?__path__=/api/khata/$1"
    },
    {
      "source": "/khata",
      "destination": "/api/index.py?__path__=/api/khata"
    },
    {
      "source": "/inventory/(.*)",
      "destination": "/api/index.py?__path__=/api/inventory/$1"
    },
    {
      "source": "/inventory",
      "destination": "/api/index.py?__path__=/api/inventory"
    },
    {
      "source": "/ocr",
      "destination": "/api/index.py?__path__=/api/ocr"
    },
    {
      "source": "/ocr/(.*)",
      "destination": "/api/index.py?__path__=/api/ocr/$1"
    },
    {
      "source": "/voice-billing",
      "destination": "/api/index.py?__path__=/api/voice-billing"
    },
    {
      "source": "/chat",
      "destination": "/api/index.py?__path__=/api/chat"
    },
    {
      "source": "/sync",
      "destination": "/api/index.py?__path__=/api/sync"
    },
    {
      "source": "/tts",
      "destination": "/api/index.py?__path__=/api/tts"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index.py?__path__=/api/dashboard"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path__=/health"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
